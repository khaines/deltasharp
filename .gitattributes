# Normalize line endings to LF in the repository and on checkout so the
# `dotnet format` end_of_line rule (see .editorconfig) stays deterministic
# across macOS, Linux, and Windows contributors.
* text=auto eol=lf

# Shell scripts must stay LF and executable.
*.sh text eol=lf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Reference-engine Parquet goldens (#806 Inc-C). Without this they rely on git's
# text=auto NUL-byte heuristic; a regenerated fixture lacking an early NUL would be
# silently CRLF->LF normalized, corrupting the file and firing the SHA256 tripwire
# as a misleading "provenance violation".
*.parquet binary
